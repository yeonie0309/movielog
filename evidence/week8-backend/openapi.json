                    "minimum": 1,
                    "maximum": 9007199254740991,
                    "example": 238
                  },
                  "score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "example": 5
                  },
                  "comment": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500,
                    "example": "다시 보고 싶은 영화입니다."
                  },
                  "addToFavorites": {
