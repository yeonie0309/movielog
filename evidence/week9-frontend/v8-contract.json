  "schemas": {
    "RatingResponseDto": {
      "type": "object",
      "properties": {
        "ratingId": {
          "type": "number",
          "example": 12
        },
        "movieId": {
          "type": "number",
          "example": 550,
          "description": "TMDB 영화 ID"
        },
        "score": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "object",
          "example": "최고의 영화!",
          "nullable": true
        },
        "createdAt": {
          "format": "date-time",
          "type": "string",
          "example": "2026-09-06T12:14:03.000Z"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string",
          "example": "2026-09-06T12:14:03.000Z"
        }
      },
      "required": [
        "ratingId",
        "movieId",
        "score",
        "comment",
        "createdAt",
        "updatedAt"
      ]
    },
    "FavoriteResponseDto": {
      "type": "object",
      "properties": {
        "favoriteId": {
          "type": "number",
          "example": 3
        },
        "movieId": {
          "type": "number",
          "example": 550,
          "description": "TMDB 영화 ID"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string",
          "example": "2026-09-06T12:14:03.000Z"
        }
      },
      "required": [
        "favoriteId",
        "movieId",
        "createdAt"
      ]
    },
    "CreateFavoriteDto": {
      "type": "object",
      "properties": {
        "movieId": {
          "type": "number",
          "example": 550,
          "minimum": 1,
          "description": "TMDB 가 부여한 영화 ID. 1 이상의 정수이고 필수입니다. 위반 시 \"영화 ID는 필수입니다.\" / \"영화 ID는 정수여야 합니다.\" / \"영화 ID는 양수여야 합니다.\""
        }
      },
      "required": [
        "movieId"
      ]
    },
    "FavoriteStatusResponseDto": {
      "type": "object",
      "properties": {
        "isFavorite": {
          "type": "boolean",
          "example": true
        }
      },
      "required": [
        "isFavorite"
      ]
    },
    "MovieRecordResponseDto": {
      "type": "object",
      "properties": {
        "rating": {
          "$ref": "#/components/schemas/RatingResponseDto"
        },
        "favorite": {
          "nullable": true,
          "type": "object",
          "allOf": [
            {
              "$ref": "#/components/schemas/FavoriteResponseDto"
            }
          ]
        }
      },
      "required": [
        "rating",
        "favorite"
      ]
    },
    "CreateMovieRecordDto": {
      "type": "object",
      "properties": {
        "movieId": {
          "type": "number",
          "example": 550,
          "minimum": 1,
          "description": "TMDB 가 부여한 영화 ID. 1 이상의 정수이고 필수입니다. 위반 시 \"영화 ID는 필수입니다.\" / \"영화 ID는 정수여야 합니다.\" / \"영화 ID는 양수여야 합니다.\""
        },
        "score": {
          "type": "number",
          "example": 5,
          "minimum": 1,
          "maximum": 5,
          "description": "1 이상 5 이하의 정수이고 필수입니다. 위반 시 \"별점은 필수입니다.\" / \"별점은 정수여야 합니다.\" / \"별점은 1점 이상이어야 합니다.\" / \"별점은 5점 이하여야 합니다.\""
        },
        "comment": {
          "type": "string",
          "example": "최고의 영화!",
          "description": "선택. **평점 API 와 달리 길이 제한이 없습니다.** 참조 구현(NestJS, Spring)이 양쪽 모두 제한을 두지 않아 그대로 따랐습니다."
        },
        "addToFavorites": {
          "type": "boolean",
          "example": true,
          "description": "평점과 함께 즐겨찾기에도 추가할지. 필수입니다. 위반 시 \"즐겨찾기 추가 여부는 true 또는 false여야 합니다.\" true 인데 이미 즐겨찾기한 영화면 평점도 저장되지 않고 전체가 롤백됩니다."
        }
      },
      "required": [
        "movieId",
        "score",
        "addToFavorites"
      ]
    }
  }
}
