{
  "info": {
    "name": "MovieLog 7주차 JWT 인증·인가",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3007"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('emailA')) {",
          "  const tag = 'w7' + pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 6);",
          "  pm.environment.set('emailA', tag + 'a@example.com');",
          "  pm.environment.set('emailB', tag + 'b@example.com');",
          "  pm.environment.set('nicknameA', tag + 'A');",
          "  pm.environment.set('nicknameB', tag + 'B');",
          "  pm.environment.set('password', 'Aa9!' + pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 준비 · 회원 A 가입",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/members",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"nickname\": \"{{nicknameA}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('공통 응답 code', () => pm.expect(body.code).to.eql('COMMON201'));",
              "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
              "pm.environment.set('memberA', body.result.memberId);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 준비 · 회원 B 가입",
