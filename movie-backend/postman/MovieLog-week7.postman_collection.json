              "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
              "pm.environment.set('tokenA', body.result.accessToken);",
              "pm.test('accessToken 존재', () => pm.expect(body.result.accessToken.split('.')).to.have.lengthOf(3));"
            ]
          }
        }
      ]
