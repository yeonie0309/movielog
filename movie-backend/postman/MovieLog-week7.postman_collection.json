    {
      "name": "03 본인 평점 등록 · memberId 없는 body",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/ratings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 155,\n  \"score\": 4,\n  \"comment\": \"JWT 소유권 검증\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('공통 응답 code', () => pm.expect(body.code).to.eql('COMMON201'));",
              "pm.test('isSuccess', () => pm.expect(body.isSuccess).to.eql(true));",
              "pm.environment.set('ratingId', body.result.ratingId);",
              "pm.test('movieId 전달', () => pm.expect(body.result.movieId).to.eql(155));"
            ]
          }
        }
      ]
    },
