{
  "info": {
    "name": "MovieLog · Week 6 · 실제 저장 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "로컬 실습용. 01→02→03 순서로 실행. password는 공개 워크북 예제 전용이며 개인 비밀번호가 아님. 5주차 GET 계약 유지. 204는 JSON 본문 없음."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3006"
    },
    {
      "key": "tag",
      "value": "w6capture01"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 회원가입 성공 · 201 · 비밀번호 응답 제외",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{tag}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{tag}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const body=pm.response.json();",
              "pm.test(\"password excluded\",()=>pm.expect(body.result).not.to.have.property(\"password\"));",
              "if(pm.response.code===201)pm.collectionVariables.set(\"memberId\",body.result.memberId);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 회원가입 입력 검증 실패 · 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-email\",\n  \"password\": \"weak\",\n  \"nickname\": \"a\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 + common response\",()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().isSuccess).to.eql(false)});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 평점 등록 · 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 5,\n  \"comment\": \"워크북 평점 등록 실습\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set(\"ratingId\",pm.response.json().result);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 평점 수정 · 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 4,\n  \"comment\": \"수정 후 조회로 확인할 후기\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 수정 후 조회 · 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      }
    },
    {
      "name": "06 중복 이메일 · 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{tag}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"newnickname\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 중복 닉네임 · 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"new-{{tag}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{tag}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 중복 평점 · 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 550,\n  \"score\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 잘못된 별점 · 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"movieId\": 155,\n  \"score\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 다른 회원의 평점 수정 · 403",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/1/ratings/{{ratingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 없는 평점 · 404",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/9007199254740991",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 평점 삭제 · 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings/{{ratingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 without body\",()=>{pm.response.to.have.status(204);pm.expect(pm.response.text()).to.eql(\"\")});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 삭제 후 조회 · 빈 배열",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/{{memberId}}/ratings"
      }
    }
  ]
}
