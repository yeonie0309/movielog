erDiagram
    MEMBERS ||--o{ SOCIAL_ACCOUNTS : has
    REGIONS ||--o{ MEMBERS : lives_in
    MEMBERS ||--o{ MEMBER_TERMS : agrees
    TERMS ||--o{ MEMBER_TERMS : records
    MEMBERS ||--o{ MEMBER_FOOD_CATEGORIES : prefers
    FOOD_CATEGORIES ||--o{ MEMBER_FOOD_CATEGORIES : selected_as
    MEMBERS ||--o{ MEMBER_MISSIONS : participates
    REGIONS o|--o{ REGIONS : contains
    REGIONS ||--o{ STORES : contains
    FOOD_CATEGORIES ||--o{ STORES : classifies
    STORES ||--o{ MISSIONS : offers
